{
  "manifest_version": 3,
  "name": "XSS Helper",
  "version": "1.2",
  "description": "Copy random XSS payload(s) to clipboard for further usage during testing procedures.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "clipboardWrite",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [{
    "resources": ["data/data.txt"],
    "matches": ["<all_urls>"]
  }]
}